-- Measures (table: customers)

Customers = COUNTROWS(customers)

Churned = SUM(customers[ChurnFlag])

Churn Rate = DIVIDE([Churned], [Customers])

-- Calculated column (table: customers)

Tenure Group =
SWITCH(
    TRUE(),
    customers[tenure] < 12, "0-11",
    customers[tenure] < 24, "12-23",
    customers[tenure] < 36, "24-35",
    customers[tenure] < 48, "36-47",
    customers[tenure] < 60, "48-59",
    "60-72"
)
